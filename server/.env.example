# ============================================
# AURORAHUB - ENVIRONMENT VARIABLES
# ============================================

# SERVER
PORT=4000
NODE_ENV=production
CLIENT_URL=https://aurorahub.vercel.app

# MONGODB
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/aurorahub

# SESSION SECRET (generate a random 64-char string)
SESSION_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHARACTER_STRING

# JWT SECRET
JWT_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_64_CHARACTER_STRING

# DISCORD OAUTH2
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET
DISCORD_CALLBACK_URL=https://aurorahub-server.onrender.com/auth/discord/callback

# DISCORD BOT
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_GUILD_ID=YOUR_DISCORD_SERVER_ID
DISCORD_ADMIN_ROLE_ID=1518750056361234452
DISCORD_SERVER_INVITE=https://discord.gg/8dUzp5WGd9

# KO-FI
KOFI_VERIFICATION_TOKEN=YOUR_KOFI_VERIFICATION_TOKEN

# FILE STORAGE (local for now, can migrate to S3)
UPLOADS_DIR=./uploads
